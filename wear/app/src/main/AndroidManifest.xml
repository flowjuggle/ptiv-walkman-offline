<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.type.watch" android:required="true"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <application android:label="P.T. Architech Walkman" android:icon="@drawable/ptiv_icon" android:allowBackup="false"
               android:theme="@android:style/Theme.Material.NoActionBar" android:usesCleartextTraffic="false">
    <meta-data android:name="com.google.android.wearable.standalone" android:value="true"/>
    <activity android:name=".WatchActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <!-- Select "PTIV - Open Walkman" on any watch face with a compatible slot. -->
    <service android:name=".PTIVShortcutComplication"
             android:exported="true"
             android:label="PTIV - Open Walkman"
             android:icon="@drawable/ptiv_complication"
             android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
      <intent-filter>
        <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/>
      </intent-filter>
      <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                 android:value="SHORT_TEXT,ICON,LONG_TEXT"/>
      <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                 android:value="0"/>
    </service>
    <service android:name=".PlaybackService" android:exported="false"
             android:foregroundServiceType="mediaPlayback"/>
    <service android:name=".CompanionReceiver"
             android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.DATA_CHANGED"/>
        <data android:scheme="wear" android:host="*" android:pathPrefix="/ptiv/"/>
      </intent-filter>
    </service>
  </application>
</manifest>
